NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stevejnr?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_DAYS=30
SEED_ADMIN_EMAIL=admin@stevejnr.com
SEED_ADMIN_PASSWORD=

# Safaricom Daraja M-Pesa STK Push
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL in sandbox/production.
MPESA_CALLBACK_URL=https://your-public-domain.example/api/v1/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
